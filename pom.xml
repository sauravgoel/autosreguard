<?xml version="1.0" encoding="UTF-8"?>
<!--
  AutoSREGuard - SRE tooling for reliable, cost-efficient AI inference.

  Design note: the runtime has ZERO third-party dependencies. SRE tooling sits in the
  blast radius of every incident, so we keep its supply chain as small as possible.
  JUnit is the only dependency and it is test-scoped.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.autosreguard</groupId>
  <artifactId>autosreguard</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>AutoSREGuard</name>
  <description>Segmented SLOs, predictive capacity, autonomous remediation and LLM-aware routing for AI inference fleets.</description>
  <url>https://github.com/sauravgoel/autosreguard</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/sauravgoel/autosreguard/blob/main/LICENSE</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Saurav Goel</name>
      <email>saurav.goel@gmail.com</email>
      <url>https://github.com/sauravgoel</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/sauravgoel/autosreguard.git</connection>
    <developerConnection>scm:git:git@github.com:sauravgoel/autosreguard.git</developerConnection>
    <url>https://github.com/sauravgoel/autosreguard</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/sauravgoel/autosreguard/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <main.class>io.autosreguard.demo.SimulationMain</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <!-- Treat the codebase as production: surface every lint warning. -->
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
